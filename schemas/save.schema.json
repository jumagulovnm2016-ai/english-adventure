{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-adventure.local/schemas/save.schema.json",
  "title": "Файл экспорта прогресса",
  "description": "Совпадает со структурой хранилищ IndexedDB. Импорт проверяет этот формат и при старой schemaVersion запускает миграции.",
  "type": "object",
  "properties": {
    "format": {
      "const": "english-adventure-save"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "profile": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 20,
          "description": "Только имя, без фамилии"
        },
        "avatar": {
          "type": "string"
        },
        "ageMode": {
          "enum": [
            "junior",
            "senior"
          ]
        },
        "settings": {
          "type": "object",
          "properties": {
            "accent": {
              "$ref": "common.schema.json#/$defs/accent"
            },
            "narrator": {
              "$ref": "common.schema.json#/$defs/gender",
              "description": "Голос, которым звучат слова в заданиях и спутник"
            },
            "volume": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "uiScale": {
              "type": "number",
              "minimum": 0.75,
              "maximum": 2
            },
            "microphone": {
              "type": "boolean"
            },
            "companionChatter": {
              "enum": [
                "rare",
                "normal",
                "often"
              ]
            },
            "ruHints": {
              "type": "boolean"
            },
            "dailyLimitMin": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 5
            }
          },
          "required": [
            "accent",
            "narrator",
            "volume",
            "uiScale",
            "microphone",
            "companionChatter",
            "ruHints",
            "dailyLimitMin"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "avatar",
        "ageMode",
        "settings"
      ],
      "additionalProperties": false
    },
    "items": {
      "description": "Состояние каждого слова/фразы, ключ — id",
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/learnId"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "new",
              "familiar_pending",
              "learning",
              "learned"
            ]
          },
          "box": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "due": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "firstSeen": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lastSeen": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "correct": {
            "type": "integer",
            "minimum": 0
          },
          "wrong": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "status",
          "box",
          "due",
          "firstSeen",
          "lastSeen",
          "correct",
          "wrong"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "description": "Журнал учебных событий (последние 20 000)",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "t": {
            "type": "string",
            "format": "date-time"
          },
          "item": {
            "$ref": "common.schema.json#/$defs/learnId"
          },
          "kind": {
            "enum": [
              "comprehension",
              "production",
              "spoken"
            ]
          },
          "mode": {
            "enum": [
              "listen_choose",
              "build_phrase",
              "say_aloud",
              "type_word",
              "find_item",
              "placement"
            ]
          },
          "result": {
            "enum": [
              "correct",
              "wrong",
              "unsure"
            ]
          },
          "hinted": {
            "type": "boolean",
            "description": "Был ли ответ после подсказки (не засчитывается в навыки)"
          },
          "chosen": {
            "$ref": "common.schema.json#/$defs/learnId",
            "description": "Что выбрал вместо верного — для учёта путаницы"
          },
          "context": {
            "type": "string",
            "description": "id квеста/диалога, review или placement"
          }
        },
        "required": [
          "t",
          "item",
          "kind",
          "mode",
          "result",
          "hinted",
          "context"
        ],
        "additionalProperties": false
      }
    },
    "quests": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/questId"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "locked",
              "available",
              "active",
              "done"
            ]
          },
          "step": {
            "type": [
              "string",
              "null"
            ]
          },
          "stars": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "completedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "step",
          "stars",
          "completedAt"
        ],
        "additionalProperties": false
      }
    },
    "world": {
      "type": "object",
      "properties": {
        "location": {
          "$ref": "common.schema.json#/$defs/location"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "inventory": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/itemId"
          }
        },
        "roomDecor": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/itemId"
          }
        }
      },
      "required": [
        "location",
        "x",
        "y",
        "inventory",
        "roomDecor"
      ],
      "additionalProperties": false
    },
    "canDo": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/canDoId"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "not_started",
              "in_progress",
              "confirmed"
            ]
          },
          "confirmedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "withoutVoice": {
            "type": "boolean"
          }
        },
        "required": [
          "status",
          "confirmedAt",
          "withoutVoice"
        ],
        "additionalProperties": false
      }
    },
    "playtime": {
      "type": "object",
      "propertyNames": {
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "installedAt": {
          "type": "string",
          "format": "date-time"
        },
        "placement": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "doneAt": {
              "type": "string",
              "format": "date-time"
            },
            "known": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "skipped": {
              "type": "boolean"
            }
          },
          "required": [
            "doneAt",
            "known",
            "total",
            "skipped"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "installedAt",
        "placement"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "exportedAt",
    "profile",
    "items",
    "events",
    "quests",
    "world",
    "canDo",
    "playtime",
    "meta"
  ],
  "additionalProperties": false
}
