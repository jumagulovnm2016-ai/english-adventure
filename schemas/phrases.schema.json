{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-adventure.local/schemas/phrases.schema.json",
  "title": "Фразы",
  "description": "Каждая английская реплика в игре — фраза отсюда (по id генерируется озвучка).",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": 1 },
    "phrases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id":    { "$ref": "common.schema.json#/$defs/phraseId" },
          "en":    { "type": "string", "minLength": 1 },
          "ru":    { "type": "string", "minLength": 1 },
          "level": { "$ref": "common.schema.json#/$defs/level" },
          "role": {
            "description": "productive — ребёнок должен уметь сказать; receptive — только понимать",
            "enum": ["productive", "receptive"]
          },
          "words":   { "type": "array", "items": { "$ref": "common.schema.json#/$defs/wordId" }, "uniqueItems": true },
          "pieces":  { "description": "Куски для режима «собери фразу»", "type": "array", "items": { "type": "string" }, "minItems": 2 },
          "accept":  { "$ref": "common.schema.json#/$defs/accept" },
          "why_ru":  { "type": "string", "description": "Объяснение «Почему так?» (старший режим), 1–2 предложения" }
        },
        "required": ["id", "en", "ru", "level", "role", "words"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "phrases"],
  "additionalProperties": false
}
